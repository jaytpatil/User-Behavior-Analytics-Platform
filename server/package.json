{
  "name": "causalfunnel-server",
  "version": "1.0.0",
  "description": "Express backend & tracking API for CausalFunnel analytics",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run --run",
